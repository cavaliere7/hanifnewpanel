{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hanifnewpanel",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "88c98316-e55c-4e01-8abb-b64fa700095c","database_name": "hanifnewpanel" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "aae3f2b597f74f26860b36c9200be53f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
